# =========================================
# Configuration Sample
# =========================================

# App Environment (production or development)
PUBLIC_APP_ENV="development"
# Branding (this should match the key used in the JSON files)
PUBLIC_BRANDING=default
# Email address of the instance administrator
# This is usually your residence hall's email address.
INSTANCE_ADMIN=
# Database provider (sheets or supabase)
PUBLIC_DB_PROVIDER=sheets
# JWT Secret (generate a 256-bit hexadecimal key)
JWT_SECRET=
# Maintenance mode (true or false; also handled by KV)
MAINTENANCE_MODE=

# -----------------------------------------
# Google Analytics and Site Verification (optional)
# -----------------------------------------
PUBLIC_GA_ID=
PUBLIC_GSV_ID=

# -----------------------------------------
# Google OAuth Clients
# -----------------------------------------
PUBLIC_GI_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GI_CLIENT_SECRET=your-client-secret

# -----------------------------------------
# Service Account (for Resident operations)
# -----------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------
# Google Sheets API: Workbook IDs
# -----------------------------------------
# Accounting
PUBLIC_GS_AW_ID=
# Resident Records
PUBLIC_GS_RR_ID=
# Shared Records
PUBLIC_GS_SR_ID=

# -----------------------------------------
# Firebase and Push Notifications
# -----------------------------------------
PUBLIC_APP_FIREBASE_ENABLED=false
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# -----------------------------------------
# Supabase
# -----------------------------------------
PUBLIC_SUPABASE_URL=
# Publishable/anon key. Safe to expose to the browser: data is protected by RLS.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses Row-Level Security. Used by scripts/cleanup-test-data.mjs.
# Supabase dashboard -> Project Settings -> API Keys -> service_role.
# Never expose this to the browser and never commit it. Keep the name unprefixed
# so it is never bundled into the client build.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------
# Features
# -----------------------------------------
PUBLIC_FEATURE_LIST={}

# -----------------------------------------
# NFRH Public Portal (server only)
# -----------------------------------------
# Never prefix credentials below with PUBLIC_.
SECONDARY_SUPABASE_URL=
SECONDARY_SUPABASE_SERVICE_ROLE_KEY=
PORTAL_GOOGLE_SERVICE_ACCOUNT_JSON=
PORTAL_GOOGLE_SHARED_DRIVE_ID=
PORTAL_GOOGLE_PUBLICATIONS_FOLDER_ID=
PORTAL_FIREBASE_PROJECT_ID=
PORTAL_FIREBASE_SERVICE_ACCOUNT_JSON=
PORTAL_FIRESTORE_PUBLICATION_COLLECTION=publication_previews
# Bytes. Defaults: PDF 20 MB; preview 300 KB.
PORTAL_MAX_PDF_BYTES=20971520
PORTAL_MAX_PREVIEW_BYTES=307200
PORTAL_MAX_HERO_IMAGE_BYTES=5242880
# Set to false to hide and block the entire Publications & Sync admin feature.
PUBLIC_PORTAL_FEATURE_ENABLED=true
